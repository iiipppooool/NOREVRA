# ---------------------------------------------------------------------------
# NOREVRA — environment
#
# Copy to .env.local for development. Set the same keys in the Vercel project
# (Project → Settings → Environment Variables).
#
# The site BUILDS AND RUNS with none of these set. Every integration reports
# its own absence: checkout returns a 501 that names what is missing, and the
# forms tell the visitor their message was received but not delivered. Nothing
# silently pretends to work.
#
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the
# server and is read inside route handlers only.
# ---------------------------------------------------------------------------

# --- Site ------------------------------------------------------------------
# The deployed origin, no trailing slash. Used for canonical URLs, Open Graph
# image URLs, the sitemap, and the Stripe return URLs. Vercel sets this for
# you only if you add it; without it the site falls back to brand.url.
NEXT_PUBLIC_SITE_URL=https://norevra.com


# --- Accounts (Auth.js + Google) -------------------------------------------
# Sign-in is Google only, with the session held in a signed cookie. There is
# no user database: order history is read back from Stripe, so an account
# stores nothing of its own.
#
# Until all three are set, /account/sign-in says plainly that sign-in is not
# connected instead of showing a button that cannot work.
#
#   AUTH_SECRET: openssl rand -base64 32
#   Google: console.cloud.google.com → Credentials → OAuth client ID →
#           Web application. Add this authorised redirect URI:
#             <your origin>/api/auth/callback/google
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Only needed if the deployment origin is not detected automatically.
AUTH_URL=


# --- Payments (Stripe) -----------------------------------------------------
# Until STRIPE_SECRET_KEY is set, /api/checkout returns 501 with the exact
# list of what it needs, and the bag page renders that list instead of a
# payment page. No payment is ever reported as taken.
#
# Start with a TEST key (sk_test_…). Card 4242 4242 4242 4242 with any future
# expiry and any CVC completes a test payment.
#
# This key also powers order history: /account/orders lists the customer's
# Stripe Checkout Sessions, so no separate order database is needed.
STRIPE_SECRET_KEY=
# Optional. Only needed when you add a webhook to fulfil orders server-side
# (see README, "Fulfilment").
STRIPE_WEBHOOK_SECRET=


# --- Enquiry email (Resend) ------------------------------------------------
# Both must be set for /api/contact to deliver. Without them the enquiry is
# validated, logged server-side, and the visitor is told plainly that it has
# not reached a mailbox yet.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=studio@norevra.com
# Must be a domain verified in Resend.
ENQUIRY_FROM_EMAIL=Norevra <studio@norevra.com>


# --- Newsletter ------------------------------------------------------------
# Any provider with a JSON POST endpoint and a bearer token: Mailchimp,
# Klaviyo, Buttondown, Resend Audiences, or your own handler. The body sent is
# {"email": "...", "source": "norevra.com"}.
NEWSLETTER_API_URL=
NEWSLETTER_API_KEY=
